# Database Configuration
POSTGRES_DB=parvis
POSTGRES_USER=parvis
POSTGRES_PASSWORD=changeme_secure_password

# Postgres image tag - bumps the db service AND its backup sidecar together (kept identical via a YAML anchor).
POSTGRES_VERSION=18-alpine

# Access control (both optional)
#
# PARVIS_PASSWORD        asked for once per browser, then required on every
#                        API request
# PARVIS_ADMIN_PASSWORD  asked for at the moment of deletion, and required
#                        only for deleting players and games
#
# Leave either blank to disable it. With both blank the site is unprotected and
# never prompts, which is the original behaviour — that is also how you hand
# access control over to Cloudflare Access later.
#
# The admin password is accepted anywhere the site password is, so whoever
# holds it only needs the one.
PARVIS_PASSWORD=
PARVIS_ADMIN_PASSWORD=

# Hall of fame (both optional)
#
# HALL_OF_FAME_ALBUM_URL  the photo album linked from the panel; has a working
#                         default, so set this only to point somewhere else
# HALL_OF_FAME_SEED       path to a JSON list of tournaments played before this
#                         app existed, which cannot be computed from the games.
#                         Defaults to backend/hall_of_fame.json; see
#                         backend/hall_of_fame.example.json for the shape.
#                         Seeded years are marked as historical and are
#                         superseded automatically once a real tournament is
#                         recorded for that year.
HALL_OF_FAME_ALBUM_URL=
HALL_OF_FAME_SEED=

# Backup Configuration
# Cron schedule: minute hour day month weekday (default: daily at 3 AM)
BACKUP_CRON_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

# NAS-backed backups (applied by the infra override).
# NAS_IP must be defined BEFORE NFS_OPTIONS (which references it). Use the same
# NAS_IP / NFS_OPTIONS values as the other services on this host.
NAS_IP=192.168.1.43
NFS_OPTIONS=addr=${NAS_IP},nolock,soft,rw
NAS_PARVIS_BACKUP_PATH=:/mnt/elephant/self-hosting/backups/parvis
